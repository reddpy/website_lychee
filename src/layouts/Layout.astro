---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Lychee — a notebook you'll keep",
  description = "A small, fast notes app for daily writing. Local-first. Free and open source. Runs on Mac, Windows, and Linux.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#F5F0DF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1D1A17" media="(prefers-color-scheme: dark)" />

    <!-- No-flash theme init: sets data-theme before paint. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('lychee-theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = saved || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Inter+Tight:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;1,8..60,400&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Lychee brand — only three colors */
    --red: #c73e3a;          /* lychee skin red */
    --ink-green: #506d56;    /* leaf — used sparingly, on the mark */
    --ink: #393737;          /* the dark warm grey from the wordmark */

    /* Paper surfaces (per brief: cream / rice-paper, dominant surface) */
    --cream: #f5f0df;        /* primary paper */
    --cream-deep: #ece5cc;   /* deeper paper — sidebars, cards */
    --paper: #f8f3e3;        /* lighter paper — nested surfaces */
    --rule: #d5cba8;         /* warm rule lines */

    /* Functional derivations of ink — neutral fades, no brown undertones */
    --ink-2: #5c5957;        /* body text */
    --ink-mute: #8e8b88;     /* captions, metadata */
    --red-deep: #a8302c;     /* hover / active red */

    /* Back-compat aliases (used by existing rules) */
    --cream-rule: var(--rule);
    --ink-soft: var(--ink-2);

    --font-display: "Libre Baskerville", "Iowan Old Style", "Hoefler Text", Georgia, serif;
    --font-body: "Source Serif 4", "Source Serif Pro", "Iowan Old Style", Georgia, serif;
    --font-ui: "Inter Tight", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;

    --measure: 62ch;
    --shell: 1180px;
    --gutter: clamp(1.25rem, 4vw, 2.5rem);

    color-scheme: light;
  }

  :root[data-theme="dark"] {
    /* Warm dark — not oxblood, not flat charcoal */
    --red: #de5852;
    --red-deep: #c84a45;
    --ink-green: #7e9684;
    --ink: #f5f0df;          /* cream is the type color in dark */

    --cream: #1d1a17;        /* warm near-black — primary surface */
    --cream-deep: #25211d;
    --paper: #221f1b;
    --rule: #3a3530;

    --ink-2: #d8d1b8;        /* body */
    --ink-mute: #9d9686;     /* muted */

    color-scheme: dark;
  }

  html { transition: background-color 200ms ease; }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  html {
    background: var(--cream);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  body {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.55;
    background: var(--cream);
  }

  ::selection {
    background: var(--red);
    color: var(--cream);
  }

  a {
    color: inherit;
    text-decoration-color: color-mix(in oklab, var(--ink) 35%, transparent);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: text-decoration-color 160ms ease, color 160ms ease;
  }

  a:hover {
    text-decoration-color: var(--red);
  }

  h1, h2, h3, h4 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--ink);
    margin: 0;
  }

  p {
    margin: 0;
  }

  .shell {
    max-width: var(--shell);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .measure {
    max-width: var(--measure);
  }

  .ui {
    font-family: var(--font-ui);
    font-feature-settings: "ss01", "cv11";
  }

  .display {
    font-family: var(--font-display);
  }

  .eyebrow {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
    font-weight: 500;
  }

  .rule {
    border: none;
    height: 1px;
    background: var(--cream-rule);
    margin: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    padding: 0.7rem 1.05rem;
    border-radius: 999px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: transform 140ms ease, background 160ms ease, color 160ms ease, border-color 160ms ease;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--red);
    color: var(--cream);
    border-color: var(--red);
  }

  .btn-primary:hover {
    background: var(--red-deep);
    border-color: var(--red-deep);
    transform: translateY(-1px);
  }

  .btn-ghost {
    background: transparent;
    color: var(--ink);
    border-color: color-mix(in oklab, var(--ink) 18%, transparent);
  }

  .btn-ghost:hover {
    border-color: var(--ink);
    transform: translateY(-1px);
  }
</style>
