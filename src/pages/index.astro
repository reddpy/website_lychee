---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Wordmark from '../components/Wordmark.astro';
import Lockup from '../components/Lockup.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import appIconRaw from '../assets/app_icon.svg?raw';
import appShot from '../assets/app_screenshots/base_app_color_padding.png';
// Wide views — full app or editor surface
import gifFocus from '../assets/app_gifs/focus-oriented-ux.gif?url';
import gifFormatting from '../assets/app_gifs/text-formatting.gif?url';
import gifSearch from '../assets/app_gifs/note-search.gif?url';
import gifHeader from '../assets/app_gifs/in-note-header-navigation.gif?url';
// Tall details — close-up on a single interaction
import gifSlash from '../assets/app_gifs/slash-menu.gif?url';
import gifMarkdown from '../assets/app_gifs/markdown-showcase.gif?url';
import gifDrag from '../assets/app_gifs/notes_tree_drag.gif?url';

const year = new Date().getFullYear();
---

<Layout>
  <a href="#main" class="skip">Skip to content</a>

  <header class="nav shell ui">
    <a href="/" class="brand-link" aria-label="Lychee">
      <Lockup height={26} />
    </a>
    <nav class="nav-links">
      <a href="#motion">In use</a>
      <a href="#local-first">Local-first</a>
      <a href="https://github.com/reddpy/lychee" rel="noopener">GitHub</a>
      <ThemeToggle />
      <a href="#download" class="btn btn-primary btn-sm">Download</a>
    </nav>
  </header>

  <main id="main">
    <!-- HERO -->
    <section class="hero shell">
      <div class="hero-copy">
        <p class="eyebrow"><span class="dot-mark"></span>&nbsp; Lychee · A notes app</p>
        <h1 class="hero-title">
          A notebook<br />
          <em>you'll keep.</em>
        </h1>
        <p class="hero-sub">
          A small, fast notes app for daily writing. Opens in a blink.
          Stores everything as one file on your computer.
        </p>
        <div class="hero-actions">
          <a href="#download" class="btn btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Download Lychee
          </a>
          <a href="https://github.com/reddpy/lychee" class="btn btn-ghost" rel="noopener">
            View on GitHub →
          </a>
        </div>
        <p class="hero-foot ui">
          Free and open source. <span aria-hidden="true">·</span> Mac, Windows, Linux. <span aria-hidden="true">·</span> No account, never.
        </p>
      </div>
    </section>

    <!-- APP PREVIEW — big, breathing on its own -->
    <section class="preview">
      <figure class="shot">
        <Image
          src={appShot}
          alt="The Lychee app showing a 'Tokyo Trip' note: a cherry-blossom checklist, a photograph, and a sidebar of notes."
          widths={[768, 1280, 1600, 1920, 2400]}
          sizes="(max-width: 768px) 100vw, (max-width: 1440px) 96vw, 1400px"
          class="shot-img"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <p class="caption ui">A note, in Lychee.</p>
    </section>

    <!-- PHILOSOPHY -->
    <section class="manifesto shell" aria-labelledby="manifesto-heading">
      <p class="eyebrow">Philosophy</p>
      <h2 id="manifesto-heading" class="section-title">
        Built to be used every day,<br />
        <em>for a long time.</em>
      </h2>

      <div class="manifesto-grid">
        <div class="essay">
          <p>
            Lychee is the notes app we wanted to use ourselves. It opens
            instantly, gets out of the way, and treats your writing like yours.
          </p>
          <p>
            Every block is a place to write. Every shortcut is bound. Every
            note is yours to organize the way you think — five levels of
            nesting, tabs for side-by-side, a single emoji for an icon if you
            want one.
          </p>
          <p>
            Your notes live on your computer as one SQLite file. You can read
            it, back it up, sync it however you like, or never sync it at all.
            No server. No cloud tier. Yours, the way notes should be.
          </p>
        </div>

        <aside class="pull">
          <p class="pull-text">
            <span class="quote-open">“</span>Local-first isn't a feature.
            It's how the app exists.<span class="quote-close">”</span>
          </p>
          <p class="pull-attr ui">— from the README</p>
        </aside>
      </div>
    </section>

    <hr class="rule shell-rule" />

    <!-- IN USE — grouped by aspect: wides first, then tall details -->
    <section id="motion" class="motion shell" aria-labelledby="motion-heading">
      <p class="eyebrow">In use</p>
      <h2 id="motion-heading" class="section-title">
        Lychee, <em>in motion.</em>
      </h2>

      <div class="motion-stack">
        <!-- Focus mode — atmospheric opener -->
        <figure class="wide">
          <h3 class="motion-title">Focus mode, on demand.</h3>
          <img
            src={gifFocus}
            alt="The sidebar collapsing to leave a clean, full-bleed writing surface."
            loading="lazy"
            decoding="async"
          />
        </figure>

        <!-- Cluster: Writing -->
        <div class="cluster cluster-stack">
          <figure class="wide">
            <h3 class="motion-title">Format from the home row.</h3>
            <img
              src={gifFormatting}
              alt="Bold, italic, and other formatting being applied with keyboard shortcuts while typing."
              loading="lazy"
              decoding="async"
            />
          </figure>

          <div class="cluster-pair">
            <figure class="tall tall-contain">
              <h3 class="motion-title">Slash for anything.</h3>
              <img
                src={gifSlash}
                alt="The slash menu listing block types to insert."
                loading="lazy"
                decoding="async"
              />
            </figure>
            <figure class="tall tall-contain">
              <h3 class="motion-title">Markdown, as you write.</h3>
              <img
                src={gifMarkdown}
                alt="Markdown shortcuts converting to formatted blocks as the user types."
                loading="lazy"
                decoding="async"
              />
            </figure>
          </div>
        </div>

        <!-- Search — standalone wide -->
        <figure class="wide">
          <h3 class="motion-title">Search across everything.</h3>
          <img
            src={gifSearch}
            alt="The search overlay returning results as the user types a query."
            loading="lazy"
            decoding="async"
          />
        </figure>

        <!-- Cluster: Navigation & organization -->
        <div class="cluster cluster-row">
          <figure class="wide">
            <h3 class="motion-title">Long notes earn the room.</h3>
            <img
              src={gifHeader}
              alt="Clicking a heading inside a long note to jump to that section."
              loading="lazy"
              decoding="async"
            />
          </figure>
          <figure class="tall">
            <h3 class="motion-title">Drag, drop, nest.</h3>
            <img
              src={gifDrag}
              alt="A note being dragged in the sidebar to reorder and nest under another note."
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <hr class="rule shell-rule" />

    <!-- LOCAL-FIRST ESSAY -->
    <section id="local-first" class="essay-section shell" aria-labelledby="lf-heading">
      <div class="essay-head">
        <p class="eyebrow">Local-first</p>
        <h2 id="lf-heading" class="section-title">
          Your notes,<br />
          <em>on your machine.</em>
        </h2>
      </div>

      <div class="essay-body measure">
        <p>
          Lychee is local-first. In practice, that means three things.
        </p>
        <p>
          <strong>One.</strong> Your notes are a file on your computer. SQLite,
          an open format, no proprietary container. If Lychee disappears
          tomorrow, your writing doesn't.
        </p>
        <p>
          <strong>Two.</strong> Nothing leaves your machine. No telemetry. No
          analytics. No background sync to a server we operate.
        </p>
        <p>
          <strong>Three.</strong> The app works offline because it only ever
          works offline. There's no online mode to fall back from.
        </p>
        <p>
          It's the only honest way to make a tool you'd trust with a decade of
          writing.
        </p>
      </div>
    </section>

    <hr class="rule shell-rule" />

    <!-- DOWNLOAD -->
    <section id="download" class="download shell">
      <div class="download-card">
        <div class="download-mark" set:html={appIconRaw}></div>
        <div class="download-copy">
          <h2 class="section-title small">
            Pour yourself a <em>copy.</em>
          </h2>
          <p class="measure">
            Lychee is free, open source, and runs on Mac, Windows, and Linux.
            Pick your platform on GitHub.
          </p>
          <div class="download-actions">
            <a href="https://github.com/reddpy/lychee/releases" class="btn btn-primary" rel="noopener">
              Download Lychee
            </a>
            <a href="https://github.com/reddpy/lychee" class="btn btn-ghost" rel="noopener">
              Browse the source →
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot shell">
    <div class="foot-top">
      <a href="/" class="brand-link" aria-label="Lychee">
        <Lockup height={28} />
      </a>
      <p class="foot-tag">Made by people with bookshelves.</p>
    </div>

    <div class="foot-bottom ui">
      <p>© {year} Lychee. MIT licensed.</p>
      <ul class="foot-links">
        <li><a href="https://github.com/reddpy/lychee" rel="noopener">GitHub</a></li>
        <li><a href="https://github.com/reddpy/lychee/blob/main/README.md" rel="noopener">README</a></li>
        <li><a href="mailto:hello@lychee.app">hello@lychee.app</a></li>
      </ul>
    </div>
  </footer>
</Layout>

<style>
  /* skip link */
  .skip {
    position: absolute;
    left: -9999px;
    top: 0.5rem;
    padding: 0.4rem 0.8rem;
    background: var(--ink);
    color: var(--cream);
    border-radius: 6px;
  }
  .skip:focus { left: 0.5rem; z-index: 50; }

  /* NAV */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.4rem;
    padding-bottom: 0.6rem;
    font-size: 0.92rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--ink);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--ink-soft);
  }
  .nav-links a:hover { color: var(--red); }

  .btn-sm {
    padding: 0.45rem 0.85rem;
    font-size: 0.85rem;
  }

  @media (max-width: 720px) {
    .nav-links { gap: 1rem; }
    .nav-links a:not(.btn) { display: none; }
  }

  /* HERO — centered text on cream */
  .hero {
    text-align: center;
    padding-top: clamp(3.5rem, 8vw, 6.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .hero-copy {
    max-width: 44rem;
    margin: 0 auto;
  }

  .eyebrow .dot-mark {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
    vertical-align: 1px;
    margin-right: 0.1rem;
  }

  .hero-title {
    font-size: clamp(2.8rem, 6.5vw, 5.2rem);
    line-height: 1.04;
    letter-spacing: -0.008em;
    margin-top: 1.2rem;
    margin-bottom: 1.6rem;
  }
  .hero-title em {
    color: var(--red);
    font-style: italic;
    font-weight: 400;
    font-family: var(--font-display);
  }

  .hero-sub {
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 36rem;
    margin: 0 auto 1.8rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 1.4rem;
  }

  .hero-foot {
    font-size: 0.85rem;
    color: var(--ink-mute);
    letter-spacing: 0.01em;
  }

  /* PREVIEW — wide, dominant, breaks beyond the shell */
  .preview {
    padding-top: 0;
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
    padding-inline: var(--gutter);
  }

  .shot {
    margin: 0 auto;
    max-width: 1400px;
    border-radius: 16px;
    overflow: hidden;
    line-height: 0;
    box-shadow:
      0 1px 0 color-mix(in oklab, var(--ink) 4%, transparent),
      0 30px 70px -30px color-mix(in oklab, var(--red) 38%, transparent),
      0 70px 140px -60px color-mix(in oklab, var(--ink) 35%, transparent);
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .caption {
    text-align: center;
    color: var(--ink-mute);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    margin-top: 1.4rem;
    font-style: italic;
  }

  /* MANIFESTO */
  .manifesto {
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .section-title {
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    line-height: 1.12;
    letter-spacing: 0;
    margin-top: 1rem;
    margin-bottom: 1.6rem;
  }
  .section-title em {
    color: var(--red);
    font-style: italic;
    font-weight: 400;
  }
  .section-title.small {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .section-lede {
    color: var(--ink-soft);
    font-size: 1.1rem;
    line-height: 1.55;
    margin-bottom: 2.5rem;
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    margin-top: 2rem;
  }

  .essay p {
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--ink-soft);
    margin-bottom: 1.2rem;
    max-width: var(--measure);
  }

  .essay p:first-child::first-letter {
    font-family: var(--font-display);
    font-size: 3.6rem;
    line-height: 0.85;
    color: var(--red);
    float: left;
    margin: 0.15rem 0.5rem 0 0;
  }

  .pull {
    padding: 1.6rem 1.6rem 1.4rem;
    background: color-mix(in oklab, var(--red) 7%, var(--paper));
    border: 1px solid color-mix(in oklab, var(--red) 18%, var(--cream-rule));
    border-radius: 4px;
    position: relative;
  }
  .pull::before {
    content: "";
    position: absolute;
    inset: 4px;
    border: 1px solid color-mix(in oklab, var(--red) 22%, transparent);
    border-radius: 2px;
    pointer-events: none;
  }
  .pull-text {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--ink);
    font-style: italic;
  }
  .quote-open, .quote-close {
    color: var(--red);
    font-size: 1.6rem;
    line-height: 0;
    position: relative;
    top: 0.18em;
  }
  .pull-attr {
    margin-top: 1rem;
    font-size: 0.78rem;
    color: var(--ink-mute);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 880px) {
    .manifesto-grid { grid-template-columns: 1fr; }
  }

  /* RULE */
  .shell-rule {
    max-width: var(--shell);
    margin-inline: auto;
    margin-block: 0;
  }

  /* IN USE — grouped by aspect ratio */
  .motion {
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  /* The title sitting above every GIF — the "showcase" headline */
  .motion-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.15;
    letter-spacing: -0.005em;
    color: var(--ink);
    margin: 0 0 0.85rem;
  }

  /* Clusters & stack */
  .motion-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6.5vw, 4.8rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* A wide GIF row (also used as the lead in a stacked cluster) */
  .wide {
    margin: 0;
    max-width: 1080px;
    margin-inline: auto;
    width: 100%;
  }

  .wide img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    border: 1px solid var(--cream-rule);
    background: var(--paper);
    box-shadow:
      0 1px 0 color-mix(in oklab, var(--ink) 4%, transparent),
      0 28px 60px -30px color-mix(in oklab, var(--ink) 30%, transparent);
  }

  /* A tall GIF — used in clusters next to a wide */
  .tall { margin: 0; }

  .tall img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top center;
    display: block;
    border-radius: 10px;
    border: 1px solid var(--cream-rule);
    background: var(--paper);
    box-shadow:
      0 16px 36px -22px color-mix(in oklab, var(--ink) 22%, transparent);
  }

  .tall-contain img {
    object-fit: contain;
    background: #ffffff;
  }

  .tall .motion-title {
    font-size: clamp(1.15rem, 1.7vw, 1.4rem);
  }

  /* Cluster: lead wide on top, supporting pair below */
  .cluster-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(1.6rem, 3.5vw, 2.6rem);
  }
  .cluster-stack .wide { max-width: 1080px; }

  .cluster-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.4rem, 3vw, 2.2rem);
    max-width: 1080px;
    margin-inline: auto;
    width: 100%;
  }

  /* Cluster: wide and tall side by side */
  .cluster-row {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: clamp(1.4rem, 3vw, 2.4rem);
    align-items: start;
    max-width: 1080px;
    margin-inline: auto;
    width: 100%;
  }
  .cluster-row figure { margin: 0; }
  .cluster-row .wide { max-width: none; }
  /* Cluster-pair talls (slash + markdown) — shorter than the default 4/5 */
  .cluster-pair .tall img {
    aspect-ratio: 1 / 1;
  }
  /* Wide keeps its natural aspect; tall in the wide+tall row matches it */
  .cluster-row .tall img {
    aspect-ratio: 5 / 6;
    object-fit: cover;
    object-position: top center;
  }

  @media (max-width: 880px) {
    .cluster-pair { grid-template-columns: 1fr; }
    .cluster-row { grid-template-columns: 1fr; }
  }

  /* ESSAY SECTION */
  .essay-section {
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
    display: grid;
    grid-template-columns: 0.9fr 1.3fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .essay-head .section-title { margin-top: 0.6rem; }

  .essay-body p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--ink-soft);
    margin-bottom: 1.1rem;
  }
  .essay-body p strong {
    color: var(--red);
    font-weight: 500;
    font-family: var(--font-display);
    font-size: 1.15em;
    margin-right: 0.15em;
  }

  @media (max-width: 880px) {
    .essay-section { grid-template-columns: 1fr; }
  }

  /* DOWNLOAD */
  .download {
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .download-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 2.8rem);
    background: var(--paper);
    border: 1px solid var(--cream-rule);
    border-radius: 8px;
  }

  .download-mark {
    width: clamp(104px, 14vw, 144px);
    flex-shrink: 0;
    line-height: 0;
    border-radius: 13.2%;
    filter: drop-shadow(0 14px 28px color-mix(in oklab, var(--ink) 22%, transparent))
            drop-shadow(0 30px 60px color-mix(in oklab, var(--ink) 18%, transparent));
  }
  .download-mark :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  .download-copy p { color: var(--ink-soft); margin-bottom: 1.3rem; }

  .download-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .hint {
    font-size: 0.82rem;
    color: var(--ink-mute);
  }

  @media (max-width: 600px) {
    .download-card { grid-template-columns: 1fr; }
    .download-mark { justify-content: flex-start; }
  }

  /* FOOTER */
  .foot {
    padding-top: 3rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--cream-rule);
    margin-top: 2rem;
  }

  .foot-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 2rem;
  }

  .foot-tag {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-mute);
    font-size: 1.05rem;
  }

  .foot-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--ink-mute);
  }

  .foot-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.2rem;
  }

  .foot-links a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .foot-links a:hover { color: var(--red); }
</style>
