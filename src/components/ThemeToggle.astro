---
// A tiny light/dark toggle. Restrained: icon-only, ghost button.
---

<button
  type="button"
  class="toggle"
  aria-label="Toggle theme"
  data-theme-toggle
>
  <svg class="i-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" />
    <path
      d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    />
  </svg>
  <svg class="i-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"
    />
  </svg>
</button>

<script is:inline>
  (function () {
    var btns = document.querySelectorAll('[data-theme-toggle]');
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var current = document.documentElement.getAttribute('data-theme') || 'light';
        var next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('lychee-theme', next); } catch (e) {}
      });
    });
  })();
</script>

<style>
  .toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    border: 1px solid color-mix(in oklab, var(--ink) 14%, transparent);
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, transform 140ms ease;
  }
  .toggle:hover {
    color: var(--red);
    border-color: var(--ink);
    transform: translateY(-1px);
  }
  .toggle:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }

  .i-sun, .i-moon { display: none; }
  :global(:root[data-theme="light"]) .i-moon { display: block; }
  :global(:root[data-theme="dark"]) .i-sun { display: block; }
</style>
