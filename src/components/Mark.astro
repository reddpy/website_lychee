---
import iconRaw from '../assets/icon.svg?raw';

interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className } = Astro.props;
---

<span
  class={`mark ${className ?? ''}`}
  style={`width: ${size}px;`}
  aria-label="Lychee"
  role="img"
  set:html={iconRaw}
></span>

<style>
  .mark {
    display: inline-block;
    line-height: 0;
  }
  .mark :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
